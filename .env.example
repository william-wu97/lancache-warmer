# ============================================================
#  lancache-warmer 配置
#  复制为 .env 后按实际情况修改。.env 已在 .gitignore 中。
# ============================================================

# NAS 的固定局域网 IP。DNS 会把游戏内容域名解析到这个地址，
# 所以必须是客户端能访问到的 IP，且建议在路由器上做静态绑定。
NAS_IP=192.168.31.3

# 时区。定时预填充按这个时间触发。
TZ=Asia/Shanghai

# Web 面板端口
WEB_PORT=8080

# ---------- 存储路径（改成你自己的实际路径） ----------
# lancache 的缓存目录，warmer 只读它来做占用统计
CACHE_DATA_DIR=/volume1/lancache/data
# warmer 自己的数据：游戏库、配置、图标缓存
WARMER_DATA_DIR=/volume1/warmer/data
# dnsmasq 配置文件所在目录
DNS_CONF_DIR=/volume1/warmer/dns

# ---------- 缓存容量 ----------
# lancache 的缓存上限，建议略小于磁盘实际可用空间
CACHE_DISK_SIZE=2048g
# 至少保留的空闲空间，防止撑满盘
MIN_FREE_DISK=50g

# ---------- 行为 ----------
# 启用的平台 provider，逗号分隔。目前只支持 steam。
PROVIDERS=steam

# 只预填充哪个平台的内容（对应 Steam depot 的 oslist）
OS_FILTER=windows

# 并发下载的 chunk 数。网络和磁盘都吃得消可以调高。
CONCURRENCY=16
